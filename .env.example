# Zammad secrets
ZAMMAD_RAILS_SECRET=changeme_generate_random_32_chars
ZAMMAD_SESSION_SECRET=changeme_generate_random_32_chars

# PostgreSQL
POSTGRES_USER=zammad
POSTGRES_PASSWORD=changeme_generate_secure_password
POSTGRES_DB=zammad

# Redis
REDIS_URL=redis://redis:6379

# Elasticsearch
ES_URL=http://elasticsearch:9200

# Keycloak (внешний)
KEYCLOAK_URL=https://openedu.urfu.ru/auth
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=zammad-help
KEYCLOAK_CLIENT_SECRET=changeme_get_from_keycloak

# Email (входящий - IMAP)
EMAIL_IMAP_SERVER=mail.openedu.urfu.ru
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=support@openedu.urfu.ru
EMAIL_IMAP_PASSWORD=changeme

# Email (исходящий - SMTP)
EMAIL_SMTP_SERVER=smtp.openedu.urfu.ru
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=support@openedu.urfu.ru
EMAIL_SMTP_PASSWORD=changeme

# System
LOG_LEVEL=info

# =============================================================================
# Channel bridges (Max / VK / Telegram)
# Enable profiles: docker compose --profile max --profile vk --profile telegram up -d
# =============================================================================
ZAMMAD_URL=http://zammad-web:3000
ZAMMAD_TOKEN=changeme_zammad_api_token
ZAMMAD_GROUP_ID=1
BRIDGE_OUTBOUND_SECRET=changeme_shared_webhook_secret
# Закрывать тикет в Zammad при /end (true/false)
BRIDGE_END_CLOSES_TICKET=true
BRIDGE_GOODBYE_MESSAGE=Обращение закрыто. Напишите снова, если понадобится помощь.

# Max (https://dev.max.ru) — webhook HTTPS + доверенный сертификат
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_URL=https://help.openedu.urfu.ru/bridges/max/webhook
MAX_WEBHOOK_SECRET=
MAX_WELCOME_MESSAGE=

# VK Callback API
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_CONFIRMATION=
VK_CALLBACK_SECRET=
VK_WELCOME_MESSAGE=

# Telegram bridge (variant C: long polling + optional proxy)
TELEGRAM_BOT_TOKEN=
# Example: socks5h://user:pass@proxy-host:1080  or  http://proxy-host:8080
TELEGRAM_PROXY=
TELEGRAM_WELCOME_MESSAGE=
